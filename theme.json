{
  "$schema": "https://schemas.wp.org/wp/6.0/theme.json",
  "version": 3,
  "customTemplates": [
    {
      "name": "landing-page",
      "title": "MenuMe Landing Page",
      "postTypes": [
        "page"
      ]
    }
  ],
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "base",
          "name": "Base",
          "color": "#02010c"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#FFFFFF"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#97A3B4"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#141414"
        },
        {
          "slug": "surface-alt",
          "name": "Surface Accent",
          "color": "#000000"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#333333"
        },
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#8BFF00"
        },
        {
          "slug": "primary-dark",
          "name": "Primary Dark",
          "color": "#6ED600"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#B7FF4A"
        },
        {
          "slug": "elevated",
          "name": "Elevated",
          "color": "#252525"
        },
        {
          "slug": "text-secondary",
          "name": "Text Secondary",
          "color": "#D7DBE2"
        }
      ],
      "gradients": [
        {
          "slug": "brand",
          "name": "Brand",
          "gradient": "linear-gradient(135deg, #000000 0%, #1B3A05 55%, #102400 100%)"
        },
        {
          "slug": "soft-brand",
          "name": "Soft Brand",
          "gradient": "linear-gradient(135deg, #1C1C1C 0%, #141414 50%, #111111 100%)"
        },
        {
          "slug": "dark",
          "name": "Dark",
          "gradient": "linear-gradient(135deg, #000000 0%, #111111 100%)"
        },
        {
          "slug": "accent-glow",
          "name": "Accent Glow",
          "gradient": "radial-gradient(circle, rgb(183 255 74 / 25%), transparent 70%)"
        },
        {
          "slug": "product-glow",
          "name": "Product Glow",
          "gradient": "radial-gradient(circle, rgb(139 255 0 / 25%), transparent 70%)"
        }
      ]
    },
    "dimensions": {
      "minHeight": true
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "sm",
          "name": "Subtle",
          "shadow": "0 0 2px 1px rgb(0 0 0 / 8%)"
        },
        {
          "slug": "md",
          "name": "Pop",
          "shadow": "0 4px 12px rgb(0 0 0 / 10%)"
        },
        {
          "slug": "lg",
          "name": "Overlay",
          "shadow": "0 12px 32px rgb(0 0 0 / 30%)"
        },
        {
          "slug": "brand",
          "name": "Accent Glow",
          "shadow": "0 16px 40px rgba(139, 255, 0, 0.24)"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "10",
          "name": "2XS",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "30",
          "name": "Small",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Medium",
          "size": "clamp(1.25rem, 2vw, 1.75rem)"
        },
        {
          "slug": "50",
          "name": "Large",
          "size": "clamp(1.75rem, 3vw, 2.5rem)"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "clamp(2.5rem, 4.5vw, 4rem)"
        },
        {
          "slug": "70",
          "name": "2XL",
          "size": "clamp(3.5rem, 6vw, 6rem)"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Modern Sans",
          "fontFamily": "\"IBM Plex Sans Arabic\", \"IBM Plex Sans\", sans-serif"
        },
        {
          "slug": "mono",
          "name": "Monospace",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "0.75rem"
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.5vw, 1.25rem)"
        },
        {
          "slug": "x-large",
          "name": "Heading 3",
          "size": "clamp(1.5rem, 2.5vw, 2rem)"
        },
        {
          "slug": "2x-large",
          "name": "Heading 2",
          "size": "clamp(2rem, 4vw, 3.25rem)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(2.75rem, 7vw, 5.5rem)"
        }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)",
      "padding": {
        "left": "var(--wp--preset--spacing--40)",
        "right": "var(--wp--preset--spacing--40)"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "6px",
          "style": "solid",
          "width": "1px",
          "color": "var(--wp--preset--color--primary)"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#111111"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "right": "1.25rem",
            "bottom": "0.8rem",
            "left": "1.25rem"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "textDecoration": "none"
        },
        ":hover": {
          "border": {
            "color": "var(--wp--preset--color--primary-dark)"
          },
          "color": {
            "background": "var(--wp--preset--color--primary-dark)",
            "text": "#111111"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.5"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2.5rem, 5vw, 4rem)",
          "fontWeight": "700",
          "letterSpacing": "-0.04em",
          "lineHeight": "1.06"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.875rem, 3vw, 2.5rem)",
          "fontWeight": "700",
          "letterSpacing": "-0.03em",
          "lineHeight": "1.12"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.5rem, 2.25vw, 1.875rem)",
          "fontWeight": "650",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.2"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "650",
          "lineHeight": "1.3"
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "shadow": "var(--wp--preset--shadow--sm)"
      },
      "core/code": {
        "border": {
          "color": "var(--wp--preset--color--border)",
          "radius": "8px",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var(--wp--preset--color--surface)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--30)",
            "right": "var(--wp--preset--spacing--30)",
            "bottom": "var(--wp--preset--spacing--30)",
            "left": "var(--wp--preset--spacing--30)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/image": {
        "border": {
          "radius": "16px"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "500"
        }
      },
      "core/paragraph": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "clamp(2.25rem, 4vw, 3.5rem)",
          "fontWeight": "700",
          "letterSpacing": "-0.035em",
          "lineHeight": "1.08"
        }
      },
      "core/quote": {
        "border": {
          "color": "var(--wp--preset--color--primary)",
          "style": "solid",
          "width": "0 0 0 3px"
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--40)"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--border)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontSize": "1.25rem",
          "fontWeight": "700",
          "letterSpacing": "-0.025em",
          "lineHeight": "1"
        }
      }
    },
    "css": "html{scroll-behavior:smooth}body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}::selection{background:#8BFF00;color:#111111}.menume-page-main>.wp-block-post-title,.menume-entry-main>.wp-block-post-title{max-width:18ch;margin-bottom:0}.menume-page-main .wp-block-post-content,.menume-entry-main .wp-block-post-content{font-size:1.0625rem}.menume-page-main .wp-block-post-content>:first-child,.menume-entry-main .wp-block-post-content>:first-child{margin-top:0}@media(max-width:600px){.menume-page-main,.menume-entry-main{padding-top:var(--wp--preset--spacing--50)!important;padding-bottom:var(--wp--preset--spacing--60)!important}}"
  }
}
