{
  "$schema": "https://schemas.wp.org/wp/6.0/theme.json",
  "version": 3,
  "customTemplates": [
    {
      "name": "landing-page",
      "title": "MenuMe Landing Page",
      "postTypes": [
        "page"
      ]
    }
  ],
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "base",
          "name": "Base",
          "color": "#FFFFFF"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#101828"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#667085"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F8FAFC"
        },
        {
          "slug": "surface-alt",
          "name": "Surface Accent",
          "color": "#EEF2FF"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#E4E7EC"
        },
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#635BFF"
        },
        {
          "slug": "primary-dark",
          "name": "Primary Dark",
          "color": "#4F46E5"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#12B8A6"
        }
      ],
      "gradients": [
        {
          "slug": "brand",
          "name": "Brand",
          "gradient": "linear-gradient(135deg, #635BFF 0%, #8B5CF6 52%, #12B8A6 100%)"
        },
        {
          "slug": "soft-brand",
          "name": "Soft Brand",
          "gradient": "linear-gradient(135deg, #EEF2FF 0%, #F5F3FF 50%, #ECFDF9 100%)"
        },
        {
          "slug": "dark",
          "name": "Dark",
          "gradient": "linear-gradient(135deg, #101828 0%, #1D2939 100%)"
        }
      ]
    },
    "dimensions": {
      "minHeight": true
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "sm",
          "name": "Small",
          "shadow": "0 1px 2px rgba(16, 24, 40, 0.06)"
        },
        {
          "slug": "md",
          "name": "Medium",
          "shadow": "0 10px 30px rgba(16, 24, 40, 0.08)"
        },
        {
          "slug": "lg",
          "name": "Large",
          "shadow": "0 24px 64px rgba(16, 24, 40, 0.12)"
        },
        {
          "slug": "brand",
          "name": "Brand Glow",
          "shadow": "0 16px 40px rgba(99, 91, 255, 0.24)"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "10",
          "name": "2XS",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "30",
          "name": "Small",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Medium",
          "size": "clamp(1.25rem, 2vw, 1.75rem)"
        },
        {
          "slug": "50",
          "name": "Large",
          "size": "clamp(1.75rem, 3vw, 2.5rem)"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "clamp(2.5rem, 4.5vw, 4rem)"
        },
        {
          "slug": "70",
          "name": "2XL",
          "size": "clamp(3.5rem, 6vw, 6rem)"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Modern Sans",
          "fontFamily": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Monospace",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "0.75rem"
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1.5vw, 1.25rem)"
        },
        {
          "slug": "x-large",
          "name": "Heading 3",
          "size": "clamp(1.5rem, 2.5vw, 2rem)"
        },
        {
          "slug": "2x-large",
          "name": "Heading 2",
          "size": "clamp(2rem, 4vw, 3.25rem)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(2.75rem, 7vw, 5.5rem)"
        }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)",
      "padding": {
        "left": "var(--wp--preset--spacing--40)",
        "right": "var(--wp--preset--spacing--40)"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "10px",
          "style": "solid",
          "width": "1px",
          "color": "var(--wp--preset--color--primary)"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "right": "1.25rem",
            "bottom": "0.8rem",
            "left": "1.25rem"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "textDecoration": "none"
        },
        ":hover": {
          "border": {
            "color": "var(--wp--preset--color--primary-dark)"
          },
          "color": {
            "background": "var(--wp--preset--color--primary-dark)",
            "text": "var(--wp--preset--color--base)"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.5"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2.5rem, 5vw, 4rem)",
          "fontWeight": "700",
          "letterSpacing": "-0.04em",
          "lineHeight": "1.06"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.875rem, 3vw, 2.5rem)",
          "fontWeight": "700",
          "letterSpacing": "-0.03em",
          "lineHeight": "1.12"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.5rem, 2.25vw, 1.875rem)",
          "fontWeight": "650",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.2"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "650",
          "lineHeight": "1.3"
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "shadow": "var(--wp--preset--shadow--sm)"
      },
      "core/code": {
        "border": {
          "color": "var(--wp--preset--color--border)",
          "radius": "10px",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var(--wp--preset--color--surface)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--30)",
            "right": "var(--wp--preset--spacing--30)",
            "bottom": "var(--wp--preset--spacing--30)",
            "left": "var(--wp--preset--spacing--30)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/image": {
        "border": {
          "radius": "16px"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "500"
        }
      },
      "core/paragraph": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "clamp(2.25rem, 4vw, 3.5rem)",
          "fontWeight": "700",
          "letterSpacing": "-0.035em",
          "lineHeight": "1.08"
        }
      },
      "core/quote": {
        "border": {
          "color": "var(--wp--preset--color--primary)",
          "style": "solid",
          "width": "0 0 0 3px"
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--40)"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--border)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontSize": "1.25rem",
          "fontWeight": "700",
          "letterSpacing": "-0.025em",
          "lineHeight": "1"
        }
      }
    },
    "css": "html{scroll-behavior:smooth}body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}::selection{background:#DDD9FF;color:#101828}.menume-site-header{z-index:100;background:rgba(255,255,255,.88);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px)}.menume-header-inner{position:relative;min-height:52px}.menume-header-brand{flex-shrink:0}.menume-header-brand .wp-block-site-title{font-size:1.25rem!important;line-height:1!important;margin:0}.menume-header-brand .wp-block-site-title a{color:var(--wp--preset--color--contrast)}.menume-header-nav{position:absolute;left:50%;transform:translateX(-50%)}.menume-header-nav .wp-block-navigation-item__content{color:var(--wp--preset--color--muted);white-space:nowrap;transition:color .2s ease}.menume-header-nav .wp-block-navigation-item__content:hover,.menume-header-nav .current-menu-item>.wp-block-navigation-item__content{color:var(--wp--preset--color--contrast)}.menume-header-actions{flex-shrink:0}.menume-header-actions .is-style-outline .wp-block-button__link{background:transparent;color:var(--wp--preset--color--contrast);border-color:var(--wp--preset--color--border);box-shadow:none}.menume-header-actions .is-style-outline .wp-block-button__link:hover{background:var(--wp--preset--color--surface);color:var(--wp--preset--color--contrast);border-color:var(--wp--preset--color--border)}.menume-page-main>.wp-block-post-title,.menume-entry-main>.wp-block-post-title{max-width:18ch;margin-bottom:0}.menume-page-main .wp-block-post-content,.menume-entry-main .wp-block-post-content{font-size:1.0625rem}.menume-page-main .wp-block-post-content>:first-child,.menume-entry-main .wp-block-post-content>:first-child{margin-top:0}@media(max-width:1024px){.menume-header-nav{position:static;margin-left:auto;transform:none}.menume-header-nav .wp-block-navigation__responsive-container.is-menu-open{padding:var(--wp--preset--spacing--40);background:var(--wp--preset--color--base);color:var(--wp--preset--color--contrast)}}@media(max-width:767px){.menume-header-actions{display:none}}@media(max-width:600px){.menume-page-main,.menume-entry-main{padding-top:var(--wp--preset--spacing--50)!important;padding-bottom:var(--wp--preset--spacing--60)!important}}"
  }
}
